---
import Layout from '../../layouts/Layout.astro';
import dataset from '../../data/seo_pages.json';

export async function getStaticPaths() {
  return dataset.map((item) => {
    const [service_slug, city_slug] = item.slug.split('/');
    return {
      params: {
        service: service_slug,
        city: city_slug
      },
      props: { data: item }
    };
  });
}

const { data } = Astro.props;

// For the select dropdown, get unique services
const allServices = [...new Map(dataset.map(item => [item.service.id, { name: item.service.name, slug: item.service.id }])).values()];
---

<Layout title={data.content.h1 + " | Deposit Return Guaranteed"} description={`Top-rated ${data.service.name.toLowerCase()} in ${data.city.name}. We help landlords and students with a 100% deposit return guarantee. Free quote.`}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900 text-white pt-12 pb-16 px-4 relative">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center space-x-2 bg-sky-950/80 border border-sky-500/30 text-sky-300 text-xs font-semibold px-3 py-1.5 rounded-full">
          <span>📍 Local Professional Cleaners Serving {data.city.name} ({data.city.postcode}) & {data.city.region}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
          {data.content.h1}
        </h1>
        <p class="text-slate-300 text-base leading-relaxed">
          {data.service.description} We are the #1 choice for Chinese students and local landlords in {data.city.name}.
        </p>
        
        <!-- Local Pain Points Block -->
        <div class="bg-slate-800/50 border-l-4 border-amber-500 p-4 rounded-r-lg mt-4">
          <p class="text-sm text-slate-300 italic leading-relaxed">
            "{data.content.pain_points}"
          </p>
        </div>

        <!-- Trust Signals - Bullet Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs text-slate-200">
          <div class="flex items-center space-x-2">
            <span class="text-emerald-400 flex-shrink-0 text-lg">✓</span>
            <span>48-Hour Deposit Return Guarantee</span>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-emerald-400 flex-shrink-0 text-lg">✓</span>
            <span>£2M Public Liability Insurance</span>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-emerald-400 flex-shrink-0 text-lg">✓</span>
            <span>Vetted & Experienced Local Cleaners</span>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-emerald-400 flex-shrink-0 text-lg">✓</span>
            <span>Transparent Pricing - No Hidden Fees</span>
          </div>
        </div>
      </div>

      <!-- Quick Fast Quote Card -->
      <div class="lg:col-span-5 bg-white text-slate-900 p-6 rounded-2xl shadow-2xl border border-slate-100 relative z-10">
        <div class="border-b border-slate-100 pb-4 mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-sky-700">Fast Local Response</span>
          <h3 class="text-xl font-extrabold text-slate-900 mt-1">Book Your Cleaning in {data.city.name}</h3>
          <p class="text-xs text-slate-500 mt-1">Secure your checkout cleaning slot early to avoid last-minute stress.</p>
        </div>

        <!-- Lead Capture Form -->
        <form action="/api/submit-lead" method="POST" class="space-y-4" id="leadForm">
          <input type="hidden" name="city" value={data.city.name} />
          <input type="hidden" name="service" value={data.service.name} />
          
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Name / 称呼</label>
            <input type="text" name="name" required class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-medium focus:ring-2 focus:ring-sky-500" placeholder="e.g. Li Lei" />
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Email / 邮箱</label>
              <input type="email" name="email" required class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-medium focus:ring-2 focus:ring-sky-500" placeholder="your@email.com" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Phone / 电话</label>
              <input type="tel" name="phone" required class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-medium focus:ring-2 focus:ring-sky-500" placeholder="07123 456789" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Project Type / 服务类型</label>
            <select name="service_slug" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-sky-500">
              {allServices.map((svc: any) => (
                <option value={svc.slug} selected={data.service.id === svc.slug}>{svc.name}</option>
              ))}
            </select>
          </div>
          
          <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold py-3 rounded-lg shadow text-sm transition mt-2">
            Get Instant Quote (免费报价) &rarr;
          </button>
          <p class="text-[10px] text-center text-slate-400 mt-2">We typically reply within 15 minutes.</p>
        </form>
      </div>
    </div>
  </section>

  <!-- Main Content Body -->
  <section class="max-w-6xl mx-auto px-4 py-12 space-y-12">
    
    <!-- Local Pricing Table -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="bg-slate-50 border-b border-slate-200 p-6">
        <h2 class="text-2xl font-bold text-slate-900">Average {data.service.name} Costs in {data.city.name}</h2>
        <p class="text-sm text-slate-600 mt-2">Prices in the {data.city.region} area vary depending on property size and condition. Here is a rough guide:</p>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="border border-slate-100 rounded-lg p-5 text-center shadow-sm">
            <h4 class="text-sm font-bold text-slate-500 uppercase tracking-wide">Studio / 1-Bed Flat</h4>
            <p class="text-2xl font-extrabold text-sky-700 mt-2">From £{data.content.pricing.small}</p>
          </div>
          <div class="border border-sky-100 bg-sky-50/50 rounded-lg p-5 text-center shadow-sm relative">
            <span class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-sky-600 text-white text-[10px] font-bold px-2 py-1 rounded-full uppercase">Most Common</span>
            <h4 class="text-sm font-bold text-sky-800 uppercase tracking-wide">2-3 Bed House</h4>
            <p class="text-2xl font-extrabold text-sky-900 mt-2">From £{data.content.pricing.medium}</p>
          </div>
          <div class="border border-slate-100 rounded-lg p-5 text-center shadow-sm">
            <h4 class="text-sm font-bold text-slate-500 uppercase tracking-wide">4+ Bed / Deep Clean</h4>
            <p class="text-2xl font-extrabold text-sky-700 mt-2">From £{data.content.pricing.large}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Local FAQs -->
    {data.content.faqs && (
      <div class="py-6">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">Frequently Asked Questions ({data.city.name})</h2>
        <div class="space-y-4">
          {data.content.faqs.map((faq: any) => (
            <div class="bg-white p-5 rounded-lg border border-slate-200">
              <h4 class="font-bold text-slate-800 mb-2">{faq.question}</h4>
              <p class="text-sm text-slate-600">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    )}
    
    <!-- Cross-Service Internal Mesh (Other services in this city) -->
    <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm mt-8">
      <h3 class="text-lg font-bold text-slate-900 mb-2">Other Cleaning Services in {data.city.name}</h3>
      <p class="text-xs text-slate-600 mb-4">Looking for something else? Our {data.city.name} teams also provide:</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        {allServices.filter(svc => svc.slug !== data.service.id).map((svc: any) => (
          <a href={`/${svc.slug}/${data.city.name.toLowerCase().replace(/ /g, '-')}`} class="flex items-center space-x-2 text-sm text-slate-700 hover:text-sky-700 font-medium group transition">
            <span class="text-sky-400 group-hover:text-sky-600">→</span>
            <span>{svc.name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Nearby Areas Coverage Block (pSEO Internal Mesh) -->
    <div class="bg-slate-100 rounded-xl p-6 border border-slate-200">
      <h3 class="text-lg font-bold text-slate-900 mb-2">Neighbouring Areas We Cover from {data.city.name}</h3>
      <p class="text-xs text-slate-600 mb-4">Our mobile cleaning squads operate across {data.city.region} and neighbouring districts:</p>
      <div class="flex flex-wrap gap-2">
        {data.content.nearby_areas.map((area: string) => (
          <a href={`/${data.service.id}/${area.toLowerCase().replace(/ /g, '-')}`} class="text-xs bg-white hover:bg-sky-50 text-slate-700 hover:text-sky-800 border border-slate-300 px-3 py-1.5 rounded-md font-medium transition">
            {area}
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
