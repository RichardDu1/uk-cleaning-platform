<!-- No verified reviews yet: kept out of the index and sitemap until real reviews are published. -->
<Layout langs={['en']} noindex title="Customer Reviews | UK Cleaning Platform" description="Verified customer reviews for UK Cleaning Platform will be published here.">
  <div class="max-w-3xl mx-auto px-4 py-16 text-center">
    <h1 class="text-4xl font-extrabold text-slate-900 mb-4">Customer Reviews</h1>
    <p class="text-lg text-slate-600 mb-8">We only publish reviews from completed, verified bookings. This page will list them once they are collected.</p>
    <a href="/quote" class="inline-block bg-sky-700 hover:bg-sky-800 text-white font-bold px-6 py-3 rounded-lg transition">Get a free fixed quote</a>
  </div>
</Layout>
