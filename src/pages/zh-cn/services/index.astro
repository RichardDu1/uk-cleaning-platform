---
import Layout from '../../../layouts/Layout.astro';
import dataset from '../../../data/seo_pages.json';

// Extract unique services
const uniqueServices = [...new Map(dataset.map(item => [item.service.id, {
  name: item.service.name_zh_cn || item.service.name,
  slug: item.service.id,
  summary: item.service.description
}])).values()];
---
<Layout title="专业清洁与清理服务目录 | 全英留学生与华人退房保洁首选" description="了解我们全方位的退房保洁、地毯蒸汽机洗、大件垃圾清理、烤箱去油烟等专业服务。100% 退房押金保障与 48 小时免费返工。">
  <div class="max-w-5xl mx-auto px-4 py-16">
    <div class="inline-flex items-center space-x-2 bg-emerald-950 text-emerald-400 border border-emerald-800 text-xs font-semibold px-3 py-1 rounded-full mb-4">
      <span>🛡️ 英国中介标准 • 48 小时免费返工 • £2M 保险</span>
    </div>
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">全英专项保洁与清理服务目录</h1>
    <p class="text-base text-slate-600 mb-12">从保障 100% 退还租房押金的退房深度清洁，到商用级地毯清洗与大件垃圾清理，全英 116 城专业团队竭诚为您服务。</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {uniqueServices.map((svc: any) => (
        <a href={`/zh-cn/${svc.slug}`} class="block bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md hover:border-sky-300 transition group">
          <div class="w-10 h-10 bg-sky-100 text-sky-800 rounded-lg flex items-center justify-center font-bold text-lg mb-4">
            ✨
          </div>
          <h3 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-sky-700 transition">{svc.name}</h3>
          <p class="text-xs text-slate-600 leading-relaxed">{svc.summary}</p>
          <span class="inline-block mt-4 text-sky-600 font-semibold text-xs group-hover:underline">选择城市与查看报价 &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</Layout>
