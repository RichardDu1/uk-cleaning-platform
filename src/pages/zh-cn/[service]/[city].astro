---
import Layout from '../../../layouts/Layout.astro';
import dataset from '../../../data/seo_pages.json';

export async function getStaticPaths() {
  return dataset.map((item) => {
    const [service_slug, city_slug] = item.slug.split('/');
    return {
      params: {
        service: service_slug,
        city: city_slug
      },
      props: { data: item }
    };
  });
}

const { data } = Astro.props;

// For the select dropdown, get unique services
const allServices = [...new Map(dataset.map(item => [item.service.id, { name: item.service.name_zh_cn, slug: item.service.id }])).values()];
---

<Layout title={data.content_zh_cn.h1 + " | 100% 退回押金保障"} description={`${data.city.name_zh_cn} 顶级华人 ${data.service.name_zh_cn} 团队。为留学生和房东提供100%退房押金保障。小红书同款推荐，免费微信报价。`}>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900 text-white pt-12 pb-16 px-4 relative">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 space-y-5">
        <div class="inline-flex items-center space-x-2 bg-rose-500/20 border border-rose-500/50 text-rose-300 text-xs font-semibold px-3 py-1.5 rounded-full">
          <span>🔥 小红书爆款推荐：覆盖 {data.city.name_zh_cn} ({data.city.postcode}) 的神仙保洁团队</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
          {data.content_zh_cn.h1}
        </h1>
        <p class="text-slate-300 text-base leading-relaxed">
          针对中国留学生的定制级退房保洁服务，专门解决重油烟、顽固污渍，包过中介检查，我们是 {data.city.name_zh_cn} 留学生和华人房东的安心首选。
        </p>
        
        <!-- Local Pain Points Block -->
        <div class="bg-slate-800/50 border-l-4 border-amber-500 p-4 rounded-r-lg mt-4">
          <p class="text-sm text-slate-300 italic leading-relaxed">
            "{data.content_zh_cn.pain_points}"
          </p>
        </div>

        <!-- Trust Signals - Bullet Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs text-slate-200">
          <div class="flex items-center space-x-2">
            <span class="text-emerald-400 flex-shrink-0 text-lg">✅</span>
            <span>48小时内无条件免费返工保押金</span>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-emerald-400 flex-shrink-0 text-lg">✅</span>
            <span>200万英镑公共责任险，损坏包赔</span>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-emerald-400 flex-shrink-0 text-lg">✅</span>
            <span>中文客服，加微信沟通零障碍</span>
          </div>
          <div class="flex items-center space-x-2">
            <span class="text-emerald-400 flex-shrink-0 text-lg">✅</span>
            <span>发图秒报一口价，绝无隐藏费用</span>
          </div>
        </div>
      </div>

      <!-- Quick Fast Quote Card -->
      <div class="lg:col-span-5 bg-white text-slate-900 p-6 rounded-2xl shadow-2xl border border-slate-100 relative z-10">
        <div class="border-b border-slate-100 pb-4 mb-4 flex justify-between items-center">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-rose-600">添加微信 快速报价</span>
            <h3 class="text-xl font-extrabold text-slate-900 mt-1">预约 {data.city.name_zh_cn} 档期</h3>
            <p class="text-xs text-slate-500 mt-1">退房旺季档期紧张，建议提前锁定位置</p>
          </div>
          <div class="text-4xl text-green-500">
            💬 <!-- Placeholder for WeChat Icon -->
          </div>
        </div>

        <!-- Lead Capture Form -->
        <form action="/api/submit-lead" method="POST" class="space-y-4" id="leadForm">
          <input type="hidden" name="city" value={data.city.name_zh_cn} />
          <input type="hidden" name="service" value={data.service.name_zh_cn} />
          
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">姓名或称呼 (Name)</label>
            <input type="text" name="name" required class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-medium focus:ring-2 focus:ring-green-500" placeholder="例如: 小李 / Li Lei" />
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">微信号 (WeChat ID)</label>
              <input type="text" name="wechat" required class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-medium focus:ring-2 focus:ring-green-500" placeholder="方便客服添加您" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">手机号 (可选)</label>
              <input type="tel" name="phone" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm font-medium focus:ring-2 focus:ring-green-500" placeholder="英国手机号" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">您需要的服务类型</label>
            <select name="service_slug" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-green-500">
              {allServices.map((svc: any) => (
                <option value={svc.slug} selected={data.service.id === svc.slug}>{svc.name}</option>
              ))}
            </select>
          </div>
          
          <button type="submit" class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 rounded-lg shadow text-sm transition mt-2">
            提交获取微信报价 &rarr;
          </button>
          <p class="text-[10px] text-center text-slate-400 mt-2">客服小姐姐收到后会火速加您微信沟通细节 🏃‍♀️</p>
        </form>
      </div>
    </div>
  </section>

  <!-- Main Content Body -->
  <section class="max-w-6xl mx-auto px-4 py-12 space-y-12">
    
    <!-- Local Pricing Table -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="bg-slate-50 border-b border-slate-200 p-6">
        <h2 class="text-2xl font-bold text-slate-900">{data.city.name_zh_cn} {data.service.name_zh_cn} 均价参考</h2>
        <p class="text-sm text-slate-600 mt-2">具体价格会根据房屋大小和脏乱程度有所变动，以下为 {data.city.region} 地区的留学生指导价：</p>
      </div>
      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="border border-slate-100 rounded-lg p-5 text-center shadow-sm">
            <h4 class="text-sm font-bold text-slate-500 uppercase tracking-wide">Studio / 一居室 (Flat)</h4>
            <p class="text-2xl font-extrabold text-sky-700 mt-2">£{data.content_zh_cn.pricing.small} 起</p>
          </div>
          <div class="border border-rose-100 bg-rose-50/30 rounded-lg p-5 text-center shadow-sm relative">
            <span class="absolute -top-3 left-1/2 transform -translate-x-1/2 bg-rose-500 text-white text-[10px] font-bold px-2 py-1 rounded-full uppercase">留学生最常见</span>
            <h4 class="text-sm font-bold text-rose-800 uppercase tracking-wide">两居到三居 (House/Flat)</h4>
            <p class="text-2xl font-extrabold text-rose-900 mt-2">£{data.content_zh_cn.pricing.medium} 起</p>
          </div>
          <div class="border border-slate-100 rounded-lg p-5 text-center shadow-sm">
            <h4 class="text-sm font-bold text-slate-500 uppercase tracking-wide">四居室以上 / 极度脏乱开荒</h4>
            <p class="text-2xl font-extrabold text-sky-700 mt-2">£{data.content_zh_cn.pricing.large} 起</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Local FAQs -->
    {data.content_zh_cn.faqs && (
      <div class="py-6">
        <h2 class="text-2xl font-bold text-slate-900 mb-6">{data.city.name_zh_cn} 常见问题解答</h2>
        <div class="space-y-4">
          {data.content_zh_cn.faqs.map((faq: any) => (
            <div class="bg-white p-5 rounded-lg border border-slate-200">
              <h4 class="font-bold text-slate-800 mb-2">{faq.question}</h4>
              <p class="text-sm text-slate-600">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    )}
    
    <!-- Cross-Service Internal Mesh (Other services in this city) -->
    <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm mt-8">
      <h3 class="text-lg font-bold text-slate-900 mb-2">{data.city.name_zh_cn} 的其他清洁与清理服务</h3>
      <p class="text-xs text-slate-600 mb-4">还需要别的帮忙？我们 {data.city.name_zh_cn} 的本地团队同样提供以下服务：</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        {allServices.filter(svc => svc.slug !== data.service.id).map((svc: any) => (
          <a href={`/zh-cn/${svc.slug}/${data.city.name.toLowerCase().replace(/ /g, '-')}`} class="flex items-center space-x-2 text-sm text-slate-700 hover:text-sky-700 font-medium group transition">
            <span class="text-sky-400 group-hover:text-sky-600">→</span>
            <span>{svc.name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Nearby Areas Coverage Block (pSEO Internal Mesh) -->
    <div class="bg-slate-100 rounded-xl p-6 border border-slate-200">
      <h3 class="text-lg font-bold text-slate-900 mb-2">{data.city.name_zh_cn} 周边覆盖城镇</h3>
      <p class="text-xs text-slate-600 mb-4">我们的流动清洁车队不仅服务市中心，还覆盖 {data.city.region} 及以下周边地区：</p>
      <div class="flex flex-wrap gap-2">
        {data.content_zh_cn.nearby_areas.map((area: string) => (
          <a href={`/zh-cn/${data.service.id}/${area.toLowerCase().replace(/ /g, '-')}`} class="text-xs bg-white hover:bg-sky-50 text-slate-700 hover:text-sky-800 border border-slate-300 px-3 py-1.5 rounded-md font-medium transition">
            {area}
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
