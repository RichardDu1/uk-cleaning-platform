---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import LeadFormScript from '../components/LeadFormScript.astro';
---
<Layout langs={['en']} title="Contact UK Cleaning Platform | Cleaning Quotes & Support" description="Contact UK Cleaning Platform about end of tenancy, deep cleaning or rubbish clearance, or to join our cleaner network. Opening hours and quote form.">
  <div class="max-w-4xl mx-auto px-4 py-16 grid grid-cols-1 md:grid-cols-2 gap-12">
    <div>
      <h1 class="text-4xl font-extrabold text-slate-900 mb-6">Contact Us</h1>
      <p class="text-slate-600 mb-8">Have a question about a project, or want to join our network of approved cleaners? Send us a message.</p>
      
      <div class="space-y-6">
        <div>
          <h4 class="font-bold text-slate-800">Email</h4>
          <p class="text-slate-600">support@UKCleaningPlatform.co.uk</p>
        </div>
        <div>
          <h4 class="font-bold text-slate-800">Operating Hours</h4>
          <p class="text-slate-600">Monday - Friday: 8:00 AM - 6:00 PM</p>
          <p class="text-slate-600">Saturday: 9:00 AM - 1:00 PM</p>
        </div>
      </div>
    </div>
    
    <div>
      <QuoteForm lang="en" formName="contact_page" />
      <p class="text-xs text-slate-500 mt-3">Need more options (property size, timeframe)? Use the <a href="/quote" class="text-sky-700 underline">full quote form</a>.</p>
    </div>
  </div>
  <LeadFormScript />
</Layout>
