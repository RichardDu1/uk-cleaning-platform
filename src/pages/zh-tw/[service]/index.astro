---
import Layout from '../../../layouts/Layout.astro';
import { toSlug } from '../../../lib/site';
import QuoteForm from '../../../components/QuoteForm.astro';
import LeadFormScript from '../../../components/LeadFormScript.astro';
import dataset from '../../../data/seo_pages.json';

export async function getStaticPaths() {
  const uniqueServices = [...new Map(dataset.map(item => [item.service.id, item.service])).values()];
  return uniqueServices.map(service => ({
    params: { service: service.id },
    props: { service }
  }));
}

const { service } = Astro.props;
const serviceData = dataset.filter(item => item.service.id === service.id);

// Group cities by region
const citiesByRegion = serviceData.reduce((acc: any, item: any) => {
  const region = item.city.region;
  if (!acc[region]) acc[region] = [];
  acc[region].push(item.city);
  return acc;
}, {});
const regions = Object.keys(citiesByRegion).sort();

// Guide-price summary derived from the city pages (no figures beyond what those pages publish).
const tierKeys = ['small', 'medium', 'large'] as const;
const tierNames = ['Studio / 一居室', '兩居到三居', '四居室以上 / 深度開荒'];
const tiers = tierKeys.map((key, i) => {
  const sorted = [...serviceData].sort((a: any, b: any) => a.content.pricing[key] - b.content.pricing[key]);
  const first: any = sorted[0];
  const last: any = sorted[sorted.length - 1];
  return {
    name: tierNames[i],
    min: first.content.pricing[key],
    max: last.content.pricing[key],
    minArea: first.city.name_zh_tw,
    maxArea: last.city.name_zh_tw,
  };
});
---

<Layout title={`${service.name_zh_tw}價格一覽（全英 ${serviceData.length} 城）£${tiers[0].min} 起 | UK Cleaning Platform`} description={`全英 ${serviceData.length} 個城市與倫敦行政區的${service.name_zh_tw}指導價：一居室 £${tiers[0].min} 起，兩到三居 £${tiers[1].min} 起，四居以上 £${tiers[2].min} 起。選擇城市查看本地報價。100%退房押金保障。`}>
  <div class="bg-slate-900 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">
        {service.name_zh_tw}
      </h1>
      <p class="text-slate-300 text-lg">請在下方選擇您所在的城市或行政區，獲取本地團隊報價</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 pt-12">
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="bg-slate-50 border-b border-slate-200 p-6">
        <h2 class="text-2xl font-bold text-slate-900">{service.name_zh_tw}：全英 {serviceData.length} 個地區指導價</h2>
        <p class="text-sm text-slate-600 mt-2">數據來自各城市頁公布的起步價（英鎊），最終一口價取決於房屋大小與髒亂程度。</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="bg-slate-50 text-slate-700 font-bold border-b border-slate-200">
            <tr><th class="p-4">房型</th><th class="p-4">最低起步價</th><th class="p-4">最高起步價</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            {tiers.map((tier) => (
              <tr>
                <td class="p-4 font-semibold text-slate-900">{tier.name}</td>
                <td class="p-4"><span class="font-bold text-sky-800">£{tier.min}</span> <span class="text-xs text-slate-500">(價格最低地區: {tier.minArea})</span></td>
                <td class="p-4"><span class="font-bold text-sky-800">£{tier.max}</span> <span class="text-xs text-slate-500">(價格最高地區: {tier.maxArea})</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-16">
    <div class="space-y-12">
      {regions.map((region) => (
        <div>
          <h2 class="text-2xl font-bold text-slate-800 mb-6 border-b pb-2">{region}</h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
            {citiesByRegion[region].sort((a: any, b: any) => a.name_zh_tw.localeCompare(b.name_zh_tw)).map((city: any) => (
              <a href={`/zh-tw/${service.id}/${toSlug(city.name)}`} class="bg-white hover:bg-sky-50 border border-slate-200 p-3 rounded-lg text-center text-sm font-medium text-slate-800 hover:text-sky-800 shadow-sm transition">
                {city.name_zh_tw}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="max-w-3xl mx-auto px-4 pb-16">
    <QuoteForm lang="zh-tw" serviceId={service.id} formName="service_page" />
  </div>
  <LeadFormScript />
</Layout>
