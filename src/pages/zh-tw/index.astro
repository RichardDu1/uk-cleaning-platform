---
import Layout from '../../layouts/Layout.astro';
import dataset from '../../data/seo_pages.json';

// Get unique services
const uniqueServices = [...new Map(dataset.map(item => [item.service.id, { name: item.service.name, slug: item.service.id, summary: item.service.description }])).values()];

// Get unique cities
const uniqueCities = [...new Map(dataset.map(item => [item.city.name, { city: item.city.name, slug: item.city.name.toLowerCase().replace(/ /g, '-'), region: item.city.region }])).values()];
---

<Layout title="UK Cleaning Platform | 留學生退房保潔首選平台" description="全英華人房東與留學生首選的退房保潔平台。直連經過嚴格審核的專業保潔團隊，提供深度清潔、地毯清洗及垃圾清理服務，100%退房押金保障。">
  <!-- Hero Banner -->
  <section class="bg-slate-900 text-white pt-16 pb-20 px-4">
    <div class="max-w-5xl mx-auto text-center space-y-6">
      <div class="inline-flex items-center space-x-2 bg-emerald-950 text-emerald-400 border border-emerald-800 text-xs font-semibold px-4 py-1.5 rounded-full">
        <span>🛡️ 華人留學生退房首選 • 200萬鎊保險 • 100% 退房押金保障</span>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white max-w-4xl mx-auto">
        全英專業退房清潔與垃圾清理
      </h1>
      <p class="text-slate-300 text-base md:text-lg max-w-2xl mx-auto">
        直連經過嚴格審核的專業保潔團隊，專門對付中式重油煙、頑固污漬與地毯清洗，一口價透明報價，無任何隱形消費。
      </p>

      <!-- Postcode Search Bar -->
      <div class="max-w-xl mx-auto bg-white p-2 rounded-xl shadow-2xl flex flex-col sm:flex-row gap-2 mt-8">
        <input type="text" id="home-postcode" placeholder="輸入您所在的城市 (如: London, Birmingham)..." class="flex-grow text-slate-900 px-4 py-3 text-sm rounded-lg focus:outline-none" />
        <button id="home-search-btn" class="bg-sky-700 hover:bg-sky-800 text-white font-bold px-6 py-3 rounded-lg text-sm transition">
          查找本地保潔團隊
        </button>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section id="services" class="max-w-6xl mx-auto px-4 py-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-3xl font-extrabold text-slate-900">專項保潔與清理服務</h2>
      <p class="text-sm text-slate-600 mt-2">所有服務均嚴格按照仲介退房檢查標準執行，提供免費返工保障。</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {uniqueServices.map((srv: any) => (
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 hover:shadow-md transition">
          <div class="w-10 h-10 bg-sky-100 text-sky-800 rounded-lg flex items-center justify-center font-bold text-lg mb-4">
            ✨
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">{srv.name}</h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">{srv.summary}</p>
          <a href={`/zh-tw/${srv.slug}`} class="text-xs font-bold text-sky-700 hover:text-sky-900 flex items-center">
            查看支持的城市與報價 →
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Popular Towns Coverage Matrix -->
  <section id="areas" class="bg-slate-100 py-16 border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-3xl font-extrabold text-slate-900">英國服務覆蓋網絡</h2>
        <p class="text-sm text-slate-600 mt-2">選擇您所在的城市或行政區，獲取本地團隊報價。</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {uniqueCities.slice(0, 48).map((city: any) => (
          <a href={`/zh-tw/end-of-tenancy-cleaning/${city.slug}`} class="bg-white hover:bg-sky-50 border border-slate-200 p-3 rounded-lg text-center text-xs font-medium text-slate-800 hover:text-sky-800 shadow-sm transition">
            <span class="block font-bold">{city.city}</span>
            <span class="text-[10px] text-slate-400">{city.region}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  document.getElementById('home-search-btn')?.addEventListener('click', () => {
    const val = (document.getElementById('home-postcode') as HTMLInputElement)?.value.toLowerCase().trim().replace(/ /g, '-');
    if (val) {
      window.location.href = `/zh-tw/end-of-tenancy-cleaning/${val}`;
    }
  });
</script>
